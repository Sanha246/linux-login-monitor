#!/bin/bash

# ==========================================
# LINUX LOGIN ACTIVITY MONITOR
# Cybersecurity Project - Bash
# ==========================================

REPORT_FILE="$HOME/linux-login-monitor/security_report.txt"
ALERT_THRESHOLD=3

get_logs() {
    sudo journalctl -u ssh --no-pager 2>/dev/null
}

successful_logins() {
    get_logs | grep -i "Accepted password" | wc -l
}

failed_logins() {
    get_logs | grep -i "Failed password" | wc -l
}

show_summary() {
    clear

    SUCCESS=$(successful_logins)
    FAILED=$(failed_logins)

    echo "=========================================="
    echo "       LINUX LOGIN ACTIVITY MONITOR"
    echo "=========================================="
    echo
    echo "Date and Time : $(date)"
    echo "Current User  : $(whoami)"
    echo
    echo "Successful SSH Logins : $SUCCESS"
    echo "Failed SSH Logins     : $FAILED"
    echo

    if [ "$FAILED" -ge "$ALERT_THRESHOLD" ]; then
        echo "=========================================="
        echo "        🚨 SECURITY ALERT 🚨"
        echo "=========================================="
        echo "Multiple failed SSH login attempts detected!"
        echo "Failed Attempts : $FAILED"
        echo "Threshold       : $ALERT_THRESHOLD"
        echo "Status          : SUSPICIOUS"
    elif [ "$FAILED" -gt 0 ]; then
        echo "STATUS: Warning - failed SSH login attempts detected."
    else
        echo "STATUS: No failed SSH login attempts detected."
    fi

    echo
    echo "=========================================="
}

show_successful() {
    clear

    echo "=========================================="
    echo "       SUCCESSFUL SSH LOGINS"
    echo "=========================================="
    echo

    get_logs | grep -i "Accepted password" || echo "No successful SSH logins found."

    echo
    echo "=========================================="
}

show_failed() {
    clear

    echo "=========================================="
    echo "          FAILED SSH LOGINS"
    echo "=========================================="
    echo

    FAILED=$(failed_logins)

    echo "Total Failed Attempts: $FAILED"
    echo

    get_logs | grep -i "Failed password" || echo "No failed SSH login attempts found."

    echo
    echo "=========================================="
}

show_ips() {
    clear

    echo "=========================================="
    echo "       LOGIN SOURCE IP ADDRESSES"
    echo "=========================================="
    echo

    echo "Successful Login IPs:"
    get_logs | grep -i "Accepted password" | \
    awk '{
        for(i=1;i<=NF;i++)
            if($i=="from")
                print $(i+1)
    }' | sort | uniq -c

    echo
    echo "Failed Login IPs:"
    get_logs | grep -i "Failed password" | \
    awk '{
        for(i=1;i<=NF;i++)
            if($i=="from")
                print $(i+1)
    }' | sort | uniq -c

    echo
    echo "=========================================="
}

generate_report() {

    SUCCESS=$(successful_logins)
    FAILED=$(failed_logins)

    {
        echo "================================================="
        echo "          LINUX LOGIN SECURITY REPORT"
        echo "================================================="
        echo
        echo "Generated On : $(date)"
        echo "System User  : $(whoami)"
        echo "Hostname     : $(hostname)"
        echo
        echo "-------------------------------------------------"
        echo "LOGIN SUMMARY"
        echo "-------------------------------------------------"
        echo "Successful SSH Logins : $SUCCESS"
        echo "Failed SSH Logins     : $FAILED"
        echo "Alert Threshold       : $ALERT_THRESHOLD"
        echo

        if [ "$FAILED" -ge "$ALERT_THRESHOLD" ]; then
            echo "STATUS : 🚨 SECURITY ALERT"
            echo "MESSAGE: Multiple failed SSH login attempts detected."
        elif [ "$FAILED" -gt 0 ]; then
            echo "STATUS : ⚠ WARNING"
            echo "MESSAGE: Failed SSH login attempts detected."
        else
            echo "STATUS : NORMAL"
            echo "MESSAGE: No failed SSH login attempts detected."
        fi

        echo
        echo "-------------------------------------------------"
        echo "SOURCE IP ADDRESSES"
        echo "-------------------------------------------------"

        echo
        echo "Successful Login IPs:"
        get_logs | grep -i "Accepted password" | \
        awk '{
            for(i=1;i<=NF;i++)
                if($i=="from")
                    print $(i+1)
        }' | sort | uniq -c

        echo
        echo "Failed Login IPs:"
        get_logs | grep -i "Failed password" | \
        awk '{
            for(i=1;i<=NF;i++)
                if($i=="from")
                    print $(i+1)
        }' | sort | uniq -c

        echo
        echo "-------------------------------------------------"
        echo "RECENT SSH EVENTS"
        echo "-------------------------------------------------"

        get_logs | tail -20

        echo
        echo "================================================="
        echo "             END OF SECURITY REPORT"
        echo "================================================="

    } > "$REPORT_FILE"

    echo
    echo "Security report generated successfully!"
    echo
    echo "Report location:"
    echo "$REPORT_FILE"
}

security_alert() {

    FAILED=$(failed_logins)

    clear

    echo "=========================================="
    echo "          SECURITY ALERT SYSTEM"
    echo "=========================================="
    echo
    echo "Failed SSH Attempts : $FAILED"
    echo "Alert Threshold      : $ALERT_THRESHOLD"
    echo

    if [ "$FAILED" -ge "$ALERT_THRESHOLD" ]; then

        echo "🚨🚨🚨 SECURITY ALERT 🚨🚨🚨"
        echo
        echo "Multiple failed SSH login attempts detected!"
        echo
        echo "Possible brute-force activity detected."
        echo "Status: SUSPICIOUS"
        echo
        echo "Recommended Action:"
        echo "1. Check the source IP addresses."
        echo "2. Review SSH logs."
        echo "3. Investigate repeated failed attempts."

    elif [ "$FAILED" -gt 0 ]; then

        echo "⚠ WARNING"
        echo
        echo "Failed SSH login attempts detected."
        echo "Continue monitoring the system."

    else

        echo "✓ SYSTEM NORMAL"
        echo
        echo "No failed SSH login attempts detected."

    fi

    echo
    echo "=========================================="
}

while true
do

    clear

    echo "=========================================="
    echo "       LINUX LOGIN ACTIVITY MONITOR"
    echo "=========================================="
    echo
    echo "1. Show Login Summary"
    echo "2. Show Successful Logins"
    echo "3. Show Failed Logins"
    echo "4. Show Source IP Addresses"
    echo "5. Generate Security Report"
    echo "6. Security Alert Check"
    echo "7. Exit"
    echo
    read -p "Enter your choice: " choice

    case $choice in

        1)
            show_summary
            read -p "Press Enter to continue..."
            ;;

        2)
            show_successful
            read -p "Press Enter to continue..."
            ;;

        3)
            show_failed
            read -p "Press Enter to continue..."
            ;;

        4)
            show_ips
            read -p "Press Enter to continue..."
            ;;

        5)
            generate_report
            read -p "Press Enter to continue..."
            ;;

        6)
            security_alert
            read -p "Press Enter to continue..."
            ;;

        7)
            echo
            echo "Exiting Login Activity Monitor..."
            exit 0
            ;;

        *)
            echo
            echo "Invalid choice!"
            sleep 2
            ;;

    esac

done
